            <textarea id="n_desc_${i}" rows="2" placeholder="محتوى الخبر" style="width:100%; background:#2a2a2a; color:#fff; border:1px solid #444; padding:5px; border-radius:4px; margin-bottom:5px;">${n.description || ''}</textarea>
