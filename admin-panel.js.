        if (ok) openPlayersManager();
    };
};

window.deletePlayer = async function (teamIndex, playerIndex) {
    if (!confirm("حذف اللاعب؟")) return;
    leagueData.teams[teamIndex].players.splice(playerIndex, 1);
    leagueData.players[leagueData.teams[teamIndex].id] = leagueData.teams[teamIndex].players;
    const ok = await saveLeagueData();
    if (ok) openPlayersManager();
};

