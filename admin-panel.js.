    const image = typeof p === "object" ? (p.image || "") : "";

    const { toolbar, body } = createModal("تعديل لاعب");
    toolbar.innerHTML = `<button class="admin-primary-button" id="btnSavePlayer">حفظ</button>`;

    body.innerHTML = `
        <div class="admin-field">
            <label>اسم اللاعب</label>
            <input type="text" id="p_name" value="${name}">
        </div>
        <div class="admin-field">
            <label>رابط الصورة</label>
            <input type="text" id="p_image" value="${image}" placeholder="https://...">
        </div>
    `;

    document.getElementById("btnSavePlayer").onclick = async () => {
        leagueData.teams[teamIndex].players[playerIndex] = {
            name: document.getElementById("p_name").value.trim(),
