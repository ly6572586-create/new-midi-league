/* =========================
   3. إدارة اللاعبين
   ========================= */
async function openPlayersManager() {
    try {
        await loadLeagueData();
        const { toolbar, body } = createModal("إدارة اللاعبين");

        if (leagueData.teams.length === 0) {
            body.innerHTML = `<div style="text-align:center;color:#888;padding:30px;">أضف فرقًا أولًا</div>`;
            return;
        }

        // اختيار الفريق
        let options = leagueData.teams.map((t, i) =>
            `<option value="\( {i}"> \){t.name}</option>`
        ).join("");

        toolbar.innerHTML = `
            <select id="playerTeamSelect" style="padding:8px 12px;border-radius:8px;background:#111;color:#fff;border:1px solid #333;">
                ${options}
            </select>
            <button class="admin-primary-button" id="btnAddPlayer">+ إضافة لاعب</button>
        `;

        const renderPlayers = () => {
            const teamIndex = Number(document.getElementById("playerTeamSelect").value);
            const team = leagueData.teams[teamIndex];
            const players = team.players || [];

            let html = `<h3 style="color:#d7ad4b;margin-bottom:12px;">${team.name}</h3>`;

            if (players.length === 0) {
                html += `<div style="color:#777;">لا يوجد لاعبين في هذا الفريق</div>`;
            } else {
                players.forEach((p, pi) => {
                    const name = typeof p === "string" ? p : (p.name || "");
                    const image = typeof p === "object" ? (p.image || "") : "";
                    html += `
                        <div class="admin-match-item">
                            <div>
                                <strong>${name}</strong>
                                \( {image ? `<span style="display:block;font-size:11px;color:#666;"> \){image.substring(0,40)}...</span>` : ""}
                            </div>
                            <div class="admin-match-actions">
                                <button onclick="editPlayer(\( {teamIndex}, \){pi})">تعديل</button>
                                <button onclick="deletePlayer(\( {teamIndex}, \){pi})" style="color:#ff9b9b;">حذف</button>
                            </div>
                        </div>
                    `;
                });
            }
            body.innerHTML = html;
        };

        document.getElementById("playerTeamSelect").onchange = renderPlayers;
        document.getElementById("btnAddPlayer").onclick = () => {
            const teamIndex = Number(document.getElementById("playerTeamSelect").value);
            leagueData.teams[teamIndex].players.push({ name: "لاعب جديد", image: "" });
            leagueData.players[leagueData.teams[teamIndex].id] = leagueData.teams[teamIndex].players;
            renderPlayers();
        };

        renderPlayers();
    } catch (e) {
        console.error(e);
        showMessage("خطأ في فتح إدارة اللاعبين", "error");
    }
}

