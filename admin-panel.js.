    leagueData.matches.forEach((m, i) => {
        html += `
        <div style="background: #1c1c1c; border: 1px solid #333; border-radius: 8px; padding: 12px; margin-bottom: 15px;">
            <div style="display:flex; justify-scale:space-between; margin-bottom:8px;">
                <strong>مباراة رقم (${i + 1}) - الجولة: ${m.round || 1}</strong>
                <button onclick="deleteMatch(${i})" style="background:#dc3545; color:#fff; border:none; padding:2px 8px; border-radius:4px; cursor:pointer;">حذف</button>
            </div>
            
            <div style="display:grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-bottom: 8px;">
                <div>
                    <label style="font-size:12px;">الفريق الأول:</label>
                    <input type="text" id="m_team1_${i}" value="${m.team1 || ''}" style="width:100%; background:#2a2a2a; color:#fff; border:1px solid #444; padding:5px; border-radius:4px;">
                </div>
                <div>
                    <label style="font-size:12px;">الفريق الثاني:</label>
                    <input type="text" id="m_team2_${i}" value="${m.team2 || ''}" style="width:100%; background:#2a2a2a; color:#fff; border:1px solid #444; padding:5px; border-radius:4px;">
                </div>
            </div>

            <div style="display:grid; grid-template-columns: 1fr 1fr 1fr; gap: 8px; margin-bottom: 8px;">
                <div>
                    <label style="font-size:12px;">أهداف ${m.team1 || 'الأول'}:</label>
                    <input type="number" id="m_score1_${i}" value="${m.score1 ?? ''}" style="width:100%; background:#2a2a2a; color:#fff; border:1px solid #444; padding:5px; border-radius:4px;">
                </div>
                <div>
                    <label style="font-size:12px;">أهداف ${m.team2 || 'الثاني'}:</label>
                    <input type="number" id="m_score2_${i}" value="${m.score2 ?? ''}" style="width:100%; background:#2a2a2a; color:#fff; border:1px solid #444; padding:5px; border-radius:4px;">
                </div>
                <div>
                    <label style="font-size:12px;">الجولة:</label>
                    <input type="number" id="m_round_${i}" value="${m.round || 1}" style="width:100%; background:#2a2a2a; color:#fff; border:1px solid #444; padding:5px; border-radius:4px;">
                </div>
            </div>

            <div style="margin-bottom:8px;">
                <label style="font-size:12px;">تاريخ ووقت المباراة:</label>
                <input type="text" id="m_date_${i}" value="${m.date || ''}" placeholder="مثال: 6 سبتمبر 2026 - 04:30 مساءً" style="width:100%; background:#2a2a2a; color:#fff; border:1px solid #444; padding:5px; border-radius:4px;">
            </div>

            <div style="margin-bottom:8px;">
                <label style="font-size:12px;">أحداث المباراة والكروت (أهداف/كروت صفراء/كروت حمراء - مفصولة بفاصلة):</label>
                <textarea id="m_events_${i}" rows="2" style="width:100%; background:#2a2a2a; color:#fff; border:1px solid #444; padding:5px; border-radius:4px;" placeholder="مثال: سلمان خالد (هدف)، هاني (بطاقة صفراء)">${Array.isArray(m.events) ? m.events.join(", ") : (m.events || '')}</textarea>
            </div>

            <button onclick="saveMatch(${i})" style="background:#d7ad4b; color:#000; font-weight:bold; border:none; padding:6px 12px; border-radius:4px; width:100%; cursor:pointer;">حفظ هذه المباراة</button>
        </div>`;
    });

    body.innerHTML = html;
}

window.addNewMatch = function() {
    leagueData.matches.unshift({ team1: "فريق جديد A", team2: "فريق جديد B", score1: null, score2: null, date: "", round: 1, events: [] });
    openMatchesManager();
};

window.saveMatch = async function(i) {
    const eventsVal = document.getElementById(`m_events_${i}`).value;
    leagueData.matches[i] = {
        team1: document.getElementById(`m_team1_${i}`).value,
        team2: document.getElementById(`m_team2_${i}`).value,
        score1: document.getElementById(`m_score1_${i}`).value !== "" ? Number(document.getElementById(`m_score1_${i}`).value) : null,
        score2: document.getElementById(`m_score2_${i}`).value !== "" ? Number(document.getElementById(`m_score2_${i}`).value) : null,
        round: Number(document.getElementById(`m_round_${i}`).value) || 1,
        date: document.getElementById(`m_date_${i}`).value,
        events: eventsVal ? eventsVal.split(",").map(e => e.trim()) : []
    };
    await saveLeagueData();
    openMatchesManager();
};

window.deleteMatch = async function(i) {
    if (confirm("هل أنت تأكد من حذف هذه المباراة؟")) {
        leagueData.matches.splice(i, 1);
        await saveLeagueData();
        openMatchesManager();
    }
};

