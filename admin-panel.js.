/* =========================
   فتح نافذة المباريات
   ========================= */

async function openMatchesManager() {

    try {

        showMessage(
            "جاري تحميل المباريات..."
        );


        await loadLeagueData();


        createMatchesModal();


        showMessage(
            "تم تحميل المباريات.",
            "success"
