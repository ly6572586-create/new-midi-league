/* =========================================
   لوحة إدارة دوري ميدي للمحترفين 2026 - الكود المطور والمستجيب
   ========================================= */

const ADMIN_UID = "91807e41-d5da-46b8-a6e6-7a8b07a40779";
const DATA_ROW_ID = 1;

let leagueData = null;

// دالة إظهار الرسائل
function showMessage(msg, type = "") {
    const messageBox = document.getElementById("adminPanelMessage");
    if (!messageBox) return;
    messageBox.textContent = msg;
    messageBox.className = "admin-panel-message " + type;
}

// 1. التحقق من صلاحية المسؤول
async function checkAdminAccess() {
    try {
        const { data: { session }, error } = await supabaseClient.auth.getSession();
        if (error || !session || !session.user || session.user.id !== ADMIN_UID) {
            window.location.href = "admin.html";
            return false;
        }
        return true;
    } catch (error) {
        window.location.href = "admin.html";
        return false;
    }
}

// 2. تحميل البيانات من Supabase
async function loadLeagueData() {
    showMessage("جاري تحميل البيانات...", "info");
    const { data, error } = await supabaseClient
        .from("league_data")
        .select("data")
        .eq("id", DATA_ROW_ID)
        .maybeSingle();

    if (error || !data) {
        alert("تعذر جلب البيانات من Supabase. تأكد من إعدادات الجدول والاتصال.");
        throw new Error("فشل الجلب");
    }

    let parsedData = data.data;
    if (typeof parsedData === "string") {
        try { parsedData = JSON.parse(parsedData); } catch (e) {}
    }

    leagueData = parsedData || {};
    if (!Array.isArray(leagueData.matches)) leagueData.matches = [];
    if (!Array.isArray(leagueData.teams)) leagueData.teams = [];
    if (!Array.isArray(leagueData.players)) leagueData.players = [];
    if (!Array.isArray(leagueData.news)) leagueData.news = [];
    if (!leagueData.settings) leagueData.settings = { leagueName: "دوري ميدي للمحترفين", season: "2026" };

    showMessage("تم تحميل البيانات بنجاح", "success");
    return leagueData;
}

// 3. حفظ البيانات في Supabase
async function saveLeagueData() {
    if (!leagueData) return;
    const { error } = await supabaseClient
        .from("league_data")
        .update({
            data: JSON.stringify(leagueData),
            updated_at: new Date().toISOString()
        })
        .eq("id", DATA_ROW_ID);

    if (error) {
        alert("خطأ في الحفظ: " + error.message);
        throw error;
    }
    alert("تم الحفظ بنجاح وتحديث البيانات!");
    return true;
}

// دالة إنشاء النافذة المنبثقة
function createModalContainer(titleHtml) {
    let modal = document.getElementById("adminUniversalModal");
    if (modal) modal.remove();

    modal = document.createElement("div");
    modal.id = "adminUniversalModal";
    modal.style.cssText = `
        position: fixed; top: 0; left: 0; width: 100%; height: 100%;
        background: rgba(0, 0, 0, 0.9); display: flex; justify-content: center;
        align-items: center; z-index: 99999; padding: 15px; box-sizing: border-box;
    `;

    modal.innerHTML = `
        <div style="background: #121212; border: 2px solid #d7ad4b; color: #fff; border-radius: 12px;
                    width: 100%; max-width: 650px; max-height: 85vh; display: flex; flex-direction: column; overflow: hidden;">
            <div style="padding: 15px; border-bottom: 1px solid #333; display: flex; justify-content: space-between; align-items: center;">
                <h3 style="margin: 0; color: #d7ad4b;">${titleHtml}</h3>
                <button id="closeAdminModal" style="background: #dc3545; border: none; color: #fff; font-size: 16px; font-weight:bold; padding:4px 10px; border-radius:4px; cursor: pointer;">✕ إغلاق</button>
            </div>
            <div id="modalBody" style="padding: 20px; overflow-y: auto; flex: 1;"></div>
        </div>
    `;

    document.body.appendChild(modal);
    document.getElementById("closeAdminModal").onclick = () => modal.remove();
    return document.getElementById("modalBody");
}

/* =========================================
   إدارة المباريات والنتائج والكروت
   ========================================= */
async function openMatchesManager() {
    try {
        await loadLeagueData();
        const body = createModalContainer("إدارة المباريات والنتائج والكروت");

        let html = `<button onclick="addNewMatch()" style="background:#28a745; color:#fff; border:none; padding:10px 15px; border-radius:6px; margin-bottom:15px; cursor:pointer; font-weight:bold; width:100%;">+ إضافة مباراة جديدة</button>`;

        leagueData.matches.forEach((m, i) => {
            html += `
            <div style="background: #1c1c1c; border: 1px solid #444; border-radius: 8px; padding: 12px; margin-bottom: 15px;">
                <div style="display:flex; justify-content:space-between; margin-bottom:8px;">
                    <strong style="color:#d7ad4b;">مباراة (${i + 1}) - الجولة ${m.round || 1}</strong>
                    <button onclick="deleteMatch(${i})" style="background:#dc3545; color:#fff; border:none; padding:3px 8px; border-radius:4px; cursor:pointer;">حذف</button>
                </div>
                
                <div style="display:grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-bottom: 8px;">
                    <div>
                        <label style="font-size:12px; color:#aaa;">الفريق الأول:</label>
                        <input type="text" id="m_team1_${i}" value="${m.team1 || ''}" style="width:100%; background:#2a2a2a; color:#fff; border:1px solid #555; padding:6px; border-radius:4px;">
                    </div>
                    <div>
                        <label style="font-size:12px; color:#aaa;">الفريق الثاني:</label>
                        <input type="text" id="m_team2_${i}" value="${m.team2 || ''}" style="width:100%; background:#2a2a2a; color:#fff; border:1px solid #555; padding:6px; border-radius:4px;">
                    </div>
                </div>

                <div style="display:grid; grid-template-columns: 1fr 1fr 1fr; gap: 8px; margin-bottom: 8px;">
                    <div>
                        <label style="font-size:12px; color:#aaa;">أهداف الأخير:</label>
                        <input type="number" id="m_score1_${i}" value="${m.score1 ?? ''}" style="width:100%; background:#2a2a2a; color:#fff; border:1px solid #555; padding:6px; border-radius:4px;">
                    </div>
                    <div>
                        <label style="font-size:12px; color:#aaa;">أهداف الثاني:</label>
                        <input type="number" id="m_score2_${i}" value="${m.score2 ?? ''}" style="width:100%; background:#2a2a2a; color:#fff; border:1px solid #555; padding:6px; border-radius:4px;">
                    </div>
                    <div>
                        <label style="font-size:12px; color:#aaa;">الجولة:</label>
                        <input type="number" id="m_round_${i}" value="${m.round || 1}" style="width:100%; background:#2a2a2a; color:#fff; border:1px solid #555; padding:6px; border-radius:4px;">
                    </div>
                </div>

                <div style="margin-bottom:8px;">
                    <label style="font-size:12px; color:#aaa;">التاريخ والوقت:</label>
                    <input type="text" id="m_date_${i}" value="${m.date || ''}" placeholder="مثال: 6 سبتمبر 2026 - 04:30 مساءً" style="width:100%; background:#2a2a2a; color:#fff; border:1px solid #555; padding:6px; border-radius:4px;">
                </div>

                <div style="margin-bottom:8px;">
                    <label style="font-size:12px; color:#aaa;">الأحداث والبطاقات (أهداف/كروت مفصولة بفاصلة):</label>
                    <textarea id="m_events_${i}" rows="2" style="width:100%; background:#2a2a2a; color:#fff; border:1px solid #555; padding:6px; border-radius:4px;">${Array.isArray(m.events) ? m.events.join(", ") : (m.events || '')}</textarea>
                </div>

                <button onclick="saveMatch(${i})" style="background:#d7ad4b; color:#000; font-weight:bold; border:none; padding:8px; border-radius:4px; width:100%; cursor:pointer;">حفظ هذه المباراة</button>
            </div>`;
        });

        body.innerHTML = html;
    } catch(e) {}
}

window.addNewMatch = function() {
    leagueData.matches.unshift({ team1: "فريق أ", team2: "فريق ب", score1: null, score2: null, date: "", round: 1, events: [] });
    openMatchesManager();
};

window.saveMatch = async function(i) {
    const eventsVal = document.getElementById(`m_events_${i}`).value;
    leagueData.matches[i] = {
        team1: document.getElementById(`m_team1_${i}`).value,
        team2: document.getElementById(`m_team2_${i}`).value,
        score1: document.getElementById(`m_score1_${i}`).value !== "" ? Number(document.getElementById(`m_score1_${i}`).value) : null,
        score2: document.getElementById(`m_score2_${i}`).value !== "" ? Number(document.getElementById(`m_score2_${i}`).value) : null,
        round: Number(document.getElementById(`m_round_${i}`).value) || 1,
        date: document.getElementById(`m_date_${i}`).value,
        events: eventsVal ? eventsVal.split(",").map(e => e.trim()) : []
    };
    await saveLeagueData();
    openMatchesManager();
};

window.deleteMatch = async function(i) {
    if (confirm("هل تريد حذف المباراة؟")) {
        leagueData.matches.splice(i, 1);
        await saveLeagueData();
        openMatchesManager();
    }
};

/* =========================================
   إدارة الفرق واللاعبين والأخبار
   ========================================= */
async function openTeamsManager() {
    await loadLeagueData();
    const body = createModalContainer("إدارة الفرق الأندية");
    let html = `<button onclick="addNewTeam()" style="background:#28a745; color:#fff; border:none; padding:8px 12px; border-radius:5px; margin-bottom:15px; cursor:pointer;">+ إضافة فريق جديد</button>`;
    leagueData.teams.forEach((t, i) => {
        html += `
        <div style="background:#1c1c1c; border:1px solid #333; padding:10px; margin-bottom:10px; border-radius:6px; display:flex; gap:8px;">
            <input type="text" id="t_name_${i}" value="${t.name || ''}" placeholder="اسم الفريق" style="flex:1; background:#2a2a2a; color:#fff; border:1px solid #444; padding:5px;">
            <button onclick="saveTeam(${i})" style="background:#d7ad4b; color:#000; border:none; padding:5px 10px; border-radius:4px; font-weight:bold;">حفظ</button>
            <button onclick="deleteTeam(${i})" style="background:#dc3545; color:#fff; border:none; padding:5px 10px; border-radius:4px;">حذف</button>
        </div>`;
    });
    body.innerHTML = html;
}

window.addNewTeam = function() { leagueData.teams.push({ name: "فريق جديد" }); openTeamsManager(); };
window.saveTeam = async function(i) { leagueData.teams[i].name = document.getElementById(`t_name_${i}`).value; await saveLeagueData(); openTeamsManager(); };
window.deleteTeam = async function(i) { if(confirm("حذف؟")) { leagueData.teams.splice(i, 1); await saveLeagueData(); openTeamsManager(); } };

// ربط النقر الذكي الشامل (يتعرف على أي زر/بطاقة في اللوحة)
document.addEventListener("DOMContentLoaded", async () => {
    const access = await checkAdminAccess();
    if (!access) return;

    // البحث بجميع الطرق الممكنة عن الكروت والأزرار
    document.body.addEventListener("click", (e) => {
        const target = e.target.closest("div, button, a");
        if (!target) return;

        const text = target.textContent || "";
        
        if (text.includes("المباريات") || target.id === "matchesAdminButton") {
            e.preventDefault();
            openMatchesManager();
        } else if (text.includes("الفرق") || target.id === "teamsAdminButton") {
            e.preventDefault();
            openTeamsManager();
        } else if (text.includes("اللاعبون") || text.includes("اللاعبين") || target.id === "playersAdminButton") {
            e.preventDefault();
            alert("قسم اللاعبين جاهز، سيتم إدراجه.");
        } else if (text.includes("الأخبار") || target.id === "newsAdminButton") {
            e.preventDefault();
            alert("قسم الأخبار جاهز، سيتم إدراجه.");
        }
    });

    const logoutBtn = document.getElementById("adminLogoutButton");
    if (logoutBtn) {
        logoutBtn.addEventListener("click", async () => {
            await supabaseClient.auth.signOut();
            window.location.href = "admin.html";
        });
    }
});
