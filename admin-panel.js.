            </div>
            <div class="admin-field">
                <label>الفريق الثاني</label>
                <input type="text" id="f_team2" value="${m.team2 || ""}">
            </div>
            <div class="admin-field">
                <label>أهداف الأول</label>
                <input type="number" id="f_score1" value="${m.score1 ?? ""}">
            </div>
            <div class="admin-field">
                <label>أهداف الثاني</label>
                <input type="number" id="f_score2" value="${m.score2 ?? ""}">
            </div>
            <div class="admin-field">
                <label>الحالة</label>
                <select id="f_status">
                    <option value="upcoming" ${m.status !== "finished" ? "selected" : ""}>قادمة</option>
                    <option value="finished" ${m.status === "finished" ? "selected" : ""}>منتهية</option>
                </select>
            </div>
            <div class="admin-field">
                <label>الجولة / المرحلة</label>
                <input type="text" id="f_stage" value="${m.stage || ""}">
            </div>
            <div class="admin-field">
                <label>التاريخ</label>
                <input type="text" id="f_date" value="${m.date || ""}" placeholder="مثال: 6 سبتمبر 2026">
            </div>
            <div class="admin-field">
                <label>الوقت</label>
                <input type="text" id="f_time" value="${m.time || ""}" placeholder="مثال: 16:30">
            </div>
        </div>

        <div class="admin-field" style="margin-top:12px;">
            <label>الهدافون (مفصولين بفاصلة)</label>
            <input type="text" id="f_scorers" value="${Array.isArray(m.scorers) ? m.scorers.map(s => typeof s === 'string' ? s : s.name).join(', ') : ''}">
        </div>

        <div class="admin-field">
            <label>البطاقات (مثال: أحمد:yellow, علي:red)</label>
            <input type="text" id="f_cards" value="${Array.isArray(m.cards) ? m.cards.map(c => typeof c === 'string' ? c : (c.name + ':' + (c.type||'yellow'))).join(', ') : ''}">
        </div>

        <div class="admin-field">
            <label>تفاصيل إضافية</label>
            <textarea id="f_details">${m.details || ""}</textarea>
        </div>
    `;

    document.getElementById("btnSaveMatch").onclick = async () => {
        const scorersRaw = document.getElementById("f_scorers").value;
        const cardsRaw = document.getElementById("f_cards").value;

        leagueData.matches[index] = {
            team1: document.getElementById("f_team1").value.trim(),
            team2: document.getElementById("f_team2").value.trim(),
            score1: document.getElementById("f_score1").value === "" ? null : Number(document.getElementById("f_score1").value),
            score2: document.getElementById("f_score2").value === "" ? null : Number(document.getElementById("f_score2").value),
            status: document.getElementById("f_status").value,
            stage: document.getElementById("f_stage").value.trim(),
            date: document.getElementById("f_date").value.trim(),
            time: document.getElementById("f_time").value.trim(),
            scorers: scorersRaw ? scorersRaw.split(",").map(s => s.trim()).filter(Boolean) : [],
            cards: cardsRaw ? cardsRaw.split(",").map(c => {
                const parts = c.trim().split(":");
                return parts.length > 1
                    ? { name: parts[0].trim(), type: parts[1].trim() }
                    : { name: parts[0].trim(), type: "yellow" };
            }) : [],
            details: document.getElementById("f_details").value.trim()
        };

        const ok = await saveLeagueData();
        if (ok) openMatchesManager();
    };
};

window.deleteMatch = async function (index) {
    if (!confirm("هل تريد حذف هذه المباراة؟")) return;
    leagueData.matches.splice(index, 1);
    const ok = await saveLeagueData();
    if (ok) openMatchesManager();
};

