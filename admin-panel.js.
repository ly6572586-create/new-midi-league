const ADMIN_UID = "91807e41-d5da-46b8-a6e6-7a8b07a40779";
const DATA_ROW_ID = 1;

let leagueData = null;

/* =========================
   رسائل
   ========================= */
function showMessage(msg, type = "") {
    const box = document.getElementById("adminPanelMessage");
    if (!box) return;
    box.textContent = msg;
    box.className = "admin-panel-message " + type;
}

/* =========================
   التحقق من صلاحية الأدمن
   ========================= */
async function checkAdminAccess() {
    try {
        const { data: { session }, error } = await supabaseClient.auth.getSession();

        if (error || !session || !session.user || session.user.id !== ADMIN_UID) {
            window.location.href = "admin.html";
            return false;
        }
        return true;
    } catch (err) {
        console.error(err);
        window.location.href = "admin.html";
        return false;
    }
}

/* =========================
   تحميل البيانات
   ========================= */
async function loadLeagueData() {
    showMessage("جاري تحميل البيانات...", "info");

    const { data, error } = await supabaseClient
        .from("league_data")
        .select("data")
        .eq("id", DATA_ROW_ID)
        .maybeSingle();

    if (error) {
        showMessage("خطأ في التحميل: " + error.message, "error");
        throw error;
    }

    if (!data || data.data === null || data.data === undefined) {
        showMessage("لا توجد بيانات في قاعدة البيانات", "error");
        throw new Error("No data");
    }

    let raw = data.data;

    // لو كان String نحوله
    if (typeof raw === "string") {
        try {
            raw = JSON.parse(raw);
        } catch (e) {
            showMessage("خطأ في تحويل البيانات", "error");
            throw e;
        }
    }

    // نستخدم نفس منطق normalize الموجود في الموقع
    leagueData = normalizeAdminData(raw);

    showMessage("تم تحميل البيانات بنجاح", "success");
    return leagueData;
}

/* =========================
   توحيد شكل البيانات
   ========================= */
function normalizeAdminData(raw) {
    const data = raw || {};

    const settings = {
        leagueName: "دوري ميدي للمحترفين",
        season: "2026",
        logo: "https://i.postimg.cc/xC7qTMXK/IMG-20260829-232623.png",
        heroTitle: "دوري ميدي",
        heroSubtitle: "للمحترفين",
        description: "أكثر من مجرد دوري... إنها أسطورة",
        ...(data.settings || {})
    };

    const teams = Array.isArray(data.teams) ? data.teams : [];
    const matches = Array.isArray(data.matches) ? data.matches : [];
    const news = Array.isArray(data.news) ? data.news : [];

    // players في الموقع الأصلي object مربوط بالـ team id
    let players = data.players && typeof data.players === "object" ? data.players : {};

    // نربط اللاعبين بالفرق لو مش موجودين
    const normalizedTeams = teams.map((team, idx) => {
        const teamId = team.id || `team_${idx}`;
        const teamPlayers = Array.isArray(players[teamId])
            ? players[teamId]
            : (Array.isArray(team.players) ? team.players : []);

        return {
            id: teamId,
            name: team.name || "فريق بدون اسم",
            logo: team.logo || "",
            players: teamPlayers
        };
    });

    // نحدث كائن اللاعبين
    players = {};
    normalizedTeams.forEach(t => {
        players[t.id] = t.players;
    });

    return {
        settings,
        teams: normalizedTeams,
        players,
        matches,
        news
    };
}

/* =========================
   حفظ البيانات
   ========================= */
async function saveLeagueData() {
    if (!leagueData) return false;

    // نجهز البيانات للحفظ بنفس الشكل اللي الموقع بيقرأه
    const toSave = {
        settings: leagueData.settings,
        teams: leagueData.teams.map(t => ({
            id: t.id,
            name: t.name,
            logo: t.logo || ""
        })),
        players: leagueData.players,
        matches: leagueData.matches,
        news: leagueData.news
    };

    const { error } = await supabaseClient
        .from("league_data")
        .update({
            data: toSave,                 // نرسل Object (أفضل لو العمود jsonb)
            updated_at: new Date().toISOString()
        })
        .eq("id", DATA_ROW_ID);

    if (error) {
        // لو فشل بسبب نوع العمود، نجرب كـ string
        const { error: err2 } = await supabaseClient
            .from("league_data")
            .update({
                data: JSON.stringify(toSave),
                updated_at: new Date().toISOString()
            })
            .eq("id", DATA_ROW_ID);

        if (err2) {
            showMessage("فشل الحفظ: " + err2.message, "error");
            alert("فشل الحفظ:\n" + err2.message);
            return false;
        }
    }

    showMessage("تم الحفظ بنجاح ✓", "success");
    return true;
}

/* =========================
   إنشاء Modal باستخدام كلاسات الـ CSS الموجودة
   ========================= */
function createModal(title) {
    // نشيل أي مودال قديم
    const old = document.getElementById("adminUniversalModal");
    if (old) old.remove();

    const modal = document.createElement("div");
    modal.id = "adminUniversalModal";
    modal.className = "admin-modal";

    modal.innerHTML = `
        <div class="admin-modal-overlay"></div>
        <div class="admin-modal-box">
            <div class="admin-modal-header">
                <h2>${title}</h2>
                <button class="admin-modal-close" type="button">×</button>
            </div>
            <div class="admin-modal-toolbar" id="modalToolbar"></div>
            <div id="modalBody" style="padding: 15px 20px 25px;"></div>
        </div>
    `;

    document.body.appendChild(modal);

    // إغلاق
    modal.querySelector(".admin-modal-close").onclick = () => modal.remove();
    modal.querySelector(".admin-modal-overlay").onclick = () => modal.remove();

    return {
        toolbar: document.getElementById("modalToolbar"),
        body: document.getElementById("modalBody"),
        close: () => modal.remove()
    };
}

/* =========================
   1. إدارة المباريات
   ========================= */
async function openMatchesManager() {
    try {
        await loadLeagueData();
        const { toolbar, body } = createModal("إدارة المباريات");

        toolbar.innerHTML = `
            <button class="admin-primary-button" id="btnAddMatch">+ إضافة مباراة جديدة</button>
        `;

        document.getElementById("btnAddMatch").onclick = () => {
            leagueData.matches.unshift({
                team1: "",
                team2: "",
                score1: null,
                score2: null,
                status: "upcoming",
                date: "",
                time: "",
                stage: "الجولة 1",
                scorers: [],
                cards: [],
                details: ""
            });
            openMatchesManager();
        };

        if (leagueData.matches.length === 0) {
            body.innerHTML = `<div style="text-align:center;color:#888;padding:30px;">لا توجد مباريات حاليًا</div>`;
            return;
        }

        let html = "";
        leagueData.matches.forEach((m, i) => {
            const isFinished = m.status === "finished";
            html += `
                <div class="admin-match-item">
                    <div>
                        <strong>${m.team1 || "؟"} × ${m.team2 || "؟"}</strong>
                        <span style="display:block;margin-top:4px;">
                            ${m.stage || ""} — ${m.date || "بدون تاريخ"}
                            ${isFinished ? ` | النتيجة: ${m.score1 ?? 0} - ${m.score2 ?? 0}` : " | قادمة"}
                        </span>
                    </div>
                    <div class="admin-match-actions">
                        <button onclick="editMatch(${i})">تعديل</button>
                        <button onclick="deleteMatch(${i})" style="color:#ff9b9b;">حذف</button>
                    </div>
                </div>
            `;
        });

        body.innerHTML = html;
    } catch (e) {
        console.error(e);
        showMessage("حدث خطأ أثناء فتح إدارة المباريات", "error");
    }
}

