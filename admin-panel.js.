        document.getElementById("btnSaveSettings").onclick = async () => {
            leagueData.settings = {
                leagueName: document.getElementById("s_leagueName").value.trim(),
                season: document.getElementById("s_season").value.trim(),
                logo: document.getElementById("s_logo").value.trim(),
                heroTitle: document.getElementById("s_heroTitle").value.trim(),
                heroSubtitle: document.getElementById("s_heroSubtitle").value.trim(),
                description: document.getElementById("s_description").value.trim()
            };
            await saveLeagueData();
        };
    } catch (e) {
        console.error(e);
    }
}

