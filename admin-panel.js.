/* =========================================
   لوحة إدارة دوري ميدي للمحترفين 2026 - الكود الشامل
   ========================================= */

const ADMIN_UID = "91807e41-d5da-46b8-a6e6-7a8b07a40779";
const DATA_ROW_ID = 1;

// الأزرار الرئيسية في لوحة التحكم
const matchesButton = document.getElementById("matchesAdminButton");
const teamsButton = document.getElementById("teamsAdminButton");
const playersButton = document.getElementById("playersAdminButton");
const newsButton = document.getElementById("newsAdminButton");
const settingsButton = document.getElementById("settingsAdminButton");
const logoutButton = document.getElementById("adminLogoutButton");
const messageBox = document.getElementById("adminPanelMessage");

let leagueData = null;

function showMessage(msg, type = "") {
    if (!messageBox) return;
    messageBox.textContent = msg;
    messageBox.className = "admin-panel-message";
    if (type) messageBox.classList.add(type);
}

// 1. التحقق من صلاحية المسؤول
async function checkAdminAccess() {
    try {
        const { data: { session }, error } = await supabaseClient.auth.getSession();
        if (error || !session || !session.user || session.user.id !== ADMIN_UID) {
            window.location.href = "admin.html";
            return false;
        }
        return true;
    } catch (error) {
        window.location.href = "admin.html";
        return false;
    }
}

// 2. تحميل البيانات من Supabase
async function loadLeagueData() {
    showMessage("جاري جلب البيانات من القاعدة...", "info");
    const { data, error } = await supabaseClient
        .from("league_data")
        .select("data")
        .eq("id", DATA_ROW_ID)
        .maybeSingle();

    if (error || !data) throw new Error("تعذر تحميل البيانات من Supabase");

    let parsedData = data.data;
    if (typeof parsedData === "string") {
        try { parsedData = JSON.parse(parsedData); } catch (e) {}
    }

    leagueData = parsedData || {};
    if (!Array.isArray(leagueData.matches)) leagueData.matches = [];
    if (!Array.isArray(leagueData.teams)) leagueData.teams = [];
    if (!Array.isArray(leagueData.players)) leagueData.players = [];
    if (!Array.isArray(leagueData.news)) leagueData.news = [];
    if (!leagueData.settings) leagueData.settings = { leagueName: "دوري ميدي للمحترفين", season: "2026" };

    showMessage("تم تحميل البيانات بنجاح", "success");
    return leagueData;
}

// 3. حفظ البيانات في Supabase
async function saveLeagueData() {
    if (!leagueData) return;
    showMessage("جاري حفظ التغييرات...", "info");
    const { error } = await supabaseClient
        .from("league_data")
        .update({
            data: JSON.stringify(leagueData),
            updated_at: new Date().toISOString()
        })
        .eq("id", DATA_ROW_ID);

    if (error) {
        showMessage("حدث خطأ أثناء الحفظ: " + error.message, "error");
        throw error;
    }
    showMessage("تم حفظ البيانات وتحديث الموقع بنجاح!", "success");
    return true;
}

// دالة إنشاء وإظهار النافذة المنبثقة (Modal)
function createModalContainer(titleHtml) {
    let modal = document.getElementById("adminUniversalModal");
    if (modal) modal.remove();

    modal = document.createElement("div");
    modal.id = "adminUniversalModal";
    modal.style.cssText = `
        position: fixed; top: 0; left: 0; width: 100%; height: 100%;
        background: rgba(0, 0, 0, 0.85); display: flex; justify-content: center;
        align-items: center; z-index: 10000; padding: 15px; box-sizing: border-box;
    `;

    modal.innerHTML = `
        <div style="background: #121212; border: 1px solid #d7ad4b; color: #fff; border-radius: 12px;
                    width: 100%; max-width: 650px; max-height: 90vh; display: flex; flex-direction: column; overflow: hidden; box-shadow: 0 0 20px rgba(215, 173, 75, 0.2);">
            <div style="padding: 15px; border-bottom: 1px solid #333; display: flex; justify-content: space-between; align-items: center;">
                <h3 style="margin: 0; color: #d7ad4b;">${titleHtml}</h3>
                <button id="closeAdminModal" style="background: transparent; border: none; color: #fff; font-size: 20px; cursor: pointer;">✕</button>
            </div>
            <div id="modalBody" style="padding: 20px; overflow-y: auto; flex: 1;"></div>
        </div>
    `;

    document.body.appendChild(modal);
    document.getElementById("closeAdminModal").onclick = () => modal.remove();
    return document.getElementById("modalBody");
}

/* ================= =========================
   قسم 1: إدارة المباريات والنتائج والكروت
   ========================================= */
async function openMatchesManager() {
    await loadLeagueData();
