/* =========================
   إعدادات الإدارة
   ========================= */

const ADMIN_UID =
    "91807e41-d5da-46b8-a6e6-7a8b07a40779";

const DATA_ROW_ID = 1;


/* =========================
   عناصر الصفحة
   ========================= */

const logoutButton =
    document.getElementById("adminLogoutButton");

const messageBox =
    document.getElementById("adminPanelMessage");

const matchesButton =
    document.getElementById("matchesAdminButton");


/* =========================
   البيانات الحالية
   ========================= */

let leagueData = null;


/* =========================
   رسائل النظام
   ========================= */

function showMessage(message, type = "") {

    if (!messageBox) return;

    messageBox.textContent = message;

    messageBox.className =
        "admin-panel-message";

    if (type) {
        messageBox.classList.add(type);
    }
}


/* =========================
   التحقق من الإدارة
   ========================= */

async function checkAdminAccess() {

    try {

        const {
            data: { session },
            error
        } = await supabaseClient.auth.getSession();


        if (error) {

            console.error(
                "خطأ في التحقق من الجلسة:",
                error
            );

            window.location.href =
                "admin.html";

            return false;
        }


        if (!session || !session.user) {

            window.location.href =
                "admin.html";

            return false;
        }


        if (
            session.user.id !== ADMIN_UID
        ) {

            await supabaseClient.auth.signOut();

            window.location.href =
                "admin.html";

            return false;
        }


        console.log(
            "تم التحقق من حساب الإدارة."
        );

        return true;

    } catch (error) {

        console.error(
            "خطأ غير متوقع:",
            error
        );

        window.location.href =
            "admin.html";

        return false;
    }
}


/* =========================
   قراءة بيانات الدوري
   ========================= */

async function loadLeagueData() {

    const {
        data,
        error
    } = await supabaseClient
        .from("league_data")
        .select("data")
        .eq("id", DATA_ROW_ID)
        .maybeSingle();


    if (error) {

        console.error(
            "خطأ تحميل بيانات الدوري:",
            error
        );

        throw error;
    }


    if (!data) {

        throw new Error(
            "لم يتم العثور على بيانات الدوري."
        );
    }


    let parsedData = data.data;


    if (typeof parsedData === "string") {

        try {

            parsedData =
                JSON.parse(parsedData);

        } catch (error) {

            console.error(
                "خطأ في قراءة JSON:",
                error
            );

            throw new Error(
                "بيانات الدوري غير صالحة."
            );
        }
    }


    if (
        !parsedData ||
        typeof parsedData !== "object"
    ) {

        throw new Error(
            "بيانات الدوري غير موجودة."
        );
    }


    if (
        !Array.isArray(parsedData.matches)
    ) {

        parsedData.matches = [];
    }


    if (
        !Array.isArray(parsedData.teams)
    ) {

        parsedData.teams = [];
    }


    leagueData = parsedData;

    return leagueData;
}


/* =========================
   حفظ بيانات الدوري
   ========================= */

async function saveLeagueData() {

    if (!leagueData) {

        throw new Error(
            "لا توجد بيانات للحفظ."
        );
    }


    const {
        error
    } = await supabaseClient
        .from("league_data")
        .update({
            data: JSON.stringify(
                leagueData
            ),
            updated_at:
                new Date().toISOString()
        })
        .eq("id", DATA_ROW_ID);


    if (error) {

        console.error(
            "خطأ حفظ بيانات الدوري:",
            error
        );

        throw error;
    }


    return true;
}


