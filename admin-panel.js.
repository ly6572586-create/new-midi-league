document.addEventListener("DOMContentLoaded", async () => {
    const access = await checkAdminAccess();
    if (!access) return;

    // ربط الأزرار بـ IDs (الأضمن)
    const matchesBtn = document.getElementById("matchesAdminButton");
    const teamsBtn = document.getElementById("teamsAdminButton");
    const playersBtn = document.getElementById("playersAdminButton");
    const newsBtn = document.getElementById("newsAdminButton");
    const settingsBtn = document.getElementById("settingsAdminButton");
    const logoutBtn = document.getElementById("adminLogoutButton");

    if (matchesBtn) matchesBtn.addEventListener("click", openMatchesManager);
    if (teamsBtn) teamsBtn.addEventListener("click", openTeamsManager);
    if (playersBtn) playersBtn.addEventListener("click", openPlayersManager);
    if (newsBtn) newsBtn.addEventListener("click", openNewsManager);
    if (settingsBtn) settingsBtn.addEventListener("click", openSettingsManager);

    if (logoutBtn) {
        logoutBtn.addEventListener("click", async () => {
            await supabaseClient.auth.signOut();
            window.location.href = "admin.html";
        });
    }

    showMessage("لوحة الإدارة جاهزة", "success");
});
