                <button onclick="saveNews(${i})" style="background:#d7ad4b; color:#000; border:none; padding:5px 10px; border-radius:4px; font-weight:bold;">حفظ الخبر</button>
                <button onclick="deleteNews(${i})" style="background:#dc3545; color:#fff; border:none; padding:5px 10px; border-radius:4px;">حذف الخبر</button>
            </div>
        </div>`;
    });
    body.innerHTML = html;
}

window.addNewNews = function() {
    leagueData.news.unshift({ title: "عنوان الخبر", description: "", date: new Date().toLocaleDateString('ar-EG') });
    openNewsManager();
};

window.saveNews = async function(i) {
    leagueData.news[i].title = document.getElementById(`n_title_${i}`).value;
    leagueData.news[i].description = document.getElementById(`n_desc_${i}`).value;
    await saveLeagueData();
    openNewsManager();
};

window.deleteNews = async function(i) {
    if (confirm("حذف الخبر؟")) {
        leagueData.news.splice(i, 1);
        await saveLeagueData();
        openNewsManager();
    }
};

/* =========================================
   قسم 5: إعدادات الدوري العامة
   ========================================= */
async function openSettingsManager() {
    await loadLeagueData();
    const body = createModalContainer("إعدادات الدوري العامة");
    const st = leagueData.settings || {};

    body.innerHTML = `
        <div style="background:#1c1c1c; padding:15px; border-radius:8px; border:1px solid #333;">
            <div style="margin-bottom:12px;">
                <label>اسم الدوري:</label>
                <input type="text" id="st_name" value="${st.leagueName || 'دوري ميدي للمحترفين'}" style="width:100%; background:#2a2a2a; color:#fff; border:1px solid #444; padding:6px; border-radius:4px; margin-top:4px;">
            </div>
            <div style="margin-bottom:12px;">
                <label>الموسم:</label>
                <input type="text" id="st_season" value="${st.season || '2026'}" style="width:100%; background:#2a2a2a; color:#fff; border:1px solid #444; padding:6px; border-radius:4px; margin-top:4px;">
            </div>
            <button onclick="saveSettings()" style="background:#d7ad4b; color:#000; border:none; padding:8px 15px; border-radius:5px; font-weight:bold; width:100%; cursor:pointer;">حفظ الإعدادات العامة</button>
        </div>
    `;
}

window.saveSettings = async function() {
    leagueData.settings = {
        leagueName: document.getElementById("st_name").value,
        season: document.getElementById("st_season").value
    };
    await saveLeagueData();
    alert("تم حفظ إعدادات الدوري بنجاح!");
};

// 4. ربط أحداث النقر وتفعيل الأزرار
document.addEventListener("DOMContentLoaded", async () => {
    const access = await checkAdminAccess();
    if (!access) return;

    if (matchesButton) matchesButton.addEventListener("click", openMatchesManager);
    if (teamsButton) teamsButton.addEventListener("click", openTeamsManager);
    if (playersButton) playersButton.addEventListener("click", openPlayersManager);
    if (newsButton) newsButton.addEventListener("click", openNewsManager);
    if (settingsButton) settingsButton.addEventListener("click", openSettingsManager);

    if (logoutButton) {
        logoutButton.addEventListener("click", async () => {
            await supabaseClient.auth.signOut();
            window.location.href = "admin.html";
        });
    }
});
