        if (
            team1.value &&
            team1.value === team2.value
        ) {

            alert(
                "لا يمكن اختيار نفس الفريق للمباراتين."
            );

            team2.value = "";

        }
    }


    team1.addEventListener(
        "change",
        validateTeams
    );

    team2.addEventListener(
        "change",
        validateTeams
    );


    document
        .getElementById(
            "cancelMatchForm"
        )
        .addEventListener(
            "click",
            function () {

                container.innerHTML = "";

            }
        );


    document
        .getElementById(
            "cancelMatchForm2"
        )
        .addEventListener(
            "click",
            function () {

                container.innerHTML = "";

            }
        );


    document
        .getElementById(
            "matchAdminForm"
        )
        .addEventListener(
            "submit",
            async function (event) {

                event.preventDefault();


                await saveMatch(
                    index,
                    match
                );

            }
        );
}


/* =========================
   حفظ المباراة
   ========================= */

async function saveMatch(
    index,
    originalMatch
) {

    const team1 =
        document.getElementById(
            "matchTeam1"
        ).value.trim();

    const team2 =
        document.getElementById(
            "matchTeam2"
        ).value.trim();

    const date =
        document.getElementById(
            "matchDate"
        ).value.trim();

    const time =
        document.getElementById(
            "matchTime"
        ).value.trim();

    const stage =
        document.getElementById(
            "matchStage"
        ).value.trim();

    const status =
        document.getElementById(
            "matchStatus"
        ).value;

    const score1 =
        Number(
            document.getElementById(
                "matchScore1"
            ).value
        );

    const score2 =
        Number(
            document.getElementById(
                "matchScore2"
            ).value
        );


    if (!team1 || !team2) {

        alert(
            "اختر الفريقين أولًا."
        );

        return;
    }


    if (team1 === team2) {

        alert(
            "لا يمكن أن يكون الفريقان متطابقين."
        );

        return;
    }


    if (!date || !time || !stage) {

        alert(
            "أكمل بيانات المباراة."
        );

        return;
    }


    if (
        Number.isNaN(score1) ||
        Number.isNaN(score2) ||
        score1 < 0 ||
        score2 < 0
    ) {

        alert(
            "أدخل نتيجة صحيحة."
        );

        return;
    }


    const updatedMatch = {

        ...originalMatch,

        id:
            originalMatch.id ??
            getNextMatchId(),

        date,

        time,

        stage,

        team1,

        team2,

        score1,

        score2,

        status,

        scorers:
            Array.isArray(
                originalMatch.scorers
            )
                ? originalMatch.scorers
                : [],

        cards:
            Array.isArray(
                originalMatch.cards
            )
                ? originalMatch.cards
                : [],

        polls:
            originalMatch.polls || {
                t1: 0,
                t2: 0
            }

    };


    try {

        showMessage(
            "جاري حفظ المباراة..."
        );


        if (index === null) {

            leagueData.matches.push(
                updatedMatch
            );

        } else {

            leagueData.matches[index] =
                updatedMatch;

        }


        await saveLeagueData();


        renderMatchesAdmin();


        const formContainer =
            document.getElementById(
                "matchFormContainer"
            );

        if (formContainer) {
            formContainer.innerHTML = "";
        }


        showMessage(
            "تم حفظ المباراة بنجاح.",
            "success"
        );


    } catch (error) {

        console.error(error);


        /*
         * إذا فشل الحفظ في Supabase
         * نرجع البيانات القديمة
         */

        if (index === null) {

            leagueData.matches.pop();

        } else {

            leagueData.matches[index] =
                originalMatch;

        }


        showMessage(
            "فشل حفظ المباراة: " +
            error.message,
            "error"
        );
    }
}


/* =========================
   حذف مباراة
   ========================= */

async function deleteMatch(index) {

    const match =
        leagueData.matches[index];


    if (!match) return;


    const confirmed =
        confirm(
            `هل أنت متأكد من حذف مباراة ${match.team1} ضد ${match.team2}؟`
        );


    if (!confirmed) return;


    const oldMatches =
        [...leagueData.matches];


    try {

        showMessage(
            "جاري حذف المباراة..."
        );


        leagueData.matches.splice(
            index,
            1
        );


        await saveLeagueData();


        renderMatchesAdmin();


        showMessage(
            "تم حذف المباراة بنجاح.",
            "success"
        );


    } catch (error) {

        console.error(error);


        leagueData.matches =
            oldMatches;


        renderMatchesAdmin();


        showMessage(
            "فشل حذف المباراة: " +
            error.message,
            "error"
        );
    }
}


/* =========================
   رقم المباراة التالي
   ========================= */

function getNextMatchId() {

    const matches =
        leagueData?.matches || [];


    const ids =
        matches
            .map(
                match => Number(match.id)
            )
            .filter(
                id => !Number.isNaN(id)
            );


    if (!ids.length) {
        return 1;
    }


    return Math.max(...ids) + 1;
}


/* =========================
   حماية النصوص داخل HTML
   ========================= */

function escapeHtml(value) {

    return String(value ?? "")
        .replace(
            /&/g,
            "&amp;"
        )
        .replace(
            /</g,
            "&lt;"
        )
        .replace(
            />/g,
            "&gt;"
        )
        .replace(
            /"/g,
            "&quot;"
        )
        .replace(
            /'/g,
            "&#039;"
        );
}


/* =========================
   زر المباريات
   ========================= */

if (matchesButton) {

    matchesButton.addEventListener(
        "click",
        openMatchesManager
    );

}


/* =========================
   تسجيل الخروج
   ========================= */

if (logoutButton) {

    logoutButton.addEventListener(
        "click",
        async function () {

            logoutButton.disabled = true;

            logoutButton.textContent =
                "جاري تسجيل الخروج...";


            const {
                error
            } =
                await supabaseClient.auth
                    .signOut();


            if (error) {

                console.error(
                    "خطأ تسجيل الخروج:",
                    error
                );


                logoutButton.disabled =
                    false;

                logoutButton.textContent =
                    "تسجيل الخروج";


                showMessage(
                    "تعذر تسجيل الخروج. حاول مرة أخرى.",
                    "error"
                );

                return;
            }


            window.location.href =
                "admin.html";

        }
    );

}


/* =========================
   تشغيل لوحة الإدارة
   ========================= */

(async function initAdminPanel() {

    const access =
        await checkAdminAccess();


    if (!access) return;


    showMessage(
        "تم تسجيل الدخول إلى لوحة الإدارة.",
        "success"
