/* =========================
   عرض المباريات
   ========================= */

function renderMatchesAdmin() {

    const list =
        document.getElementById(
            "matchesAdminList"
        );

    if (!list) return;


    const matches =
        leagueData?.matches || [];


    if (!matches.length) {

        list.innerHTML = `

            <div class="admin-empty-state">

                <strong>
                    لا توجد مباريات
                </strong>

                <span>
                    اضغط على «إضافة مباراة» لإنشاء أول مباراة.
                </span>

            </div>
        `;

        return;
    }


    list.innerHTML = "";


    matches.forEach(
        function (match, index) {

            const card =
                document.createElement("div");

            card.className =
                "match-admin-card";


            const statusText =
                match.status === "finished"
                    ? "انتهت"
                    : match.status === "live"
                        ? "مباشر"
                        : "قادمة";


            const scoreText =
                match.status === "finished"
                    ? `${match.score1 ?? 0} - ${match.score2 ?? 0}`
                    : "لم تبدأ";


            card.innerHTML = `

                <div class="match-admin-info">

                    <span class="match-admin-stage">
                        ${escapeHtml(
                            match.stage || ""
                        )}
                    </span>

                    <strong>
                        ${escapeHtml(
                            match.team1 || "الفريق الأول"
                        )}

                        <b>${scoreText}</b>

                        ${escapeHtml(
                            match.team2 || "الفريق الثاني"
                        )}
                    </strong>

                    <small>
                        ${escapeHtml(
                            match.date || ""
                        )}

                        —

                        ${escapeHtml(
                            match.time || ""
                        )}
                    </small>

                    <em>
                        ${statusText}
                    </em>

                </div>


                <div class="match-admin-actions">

                    <button
                        type="button"
                        class="admin-edit-match"
                        data-index="${index}">

                        تعديل

                    </button>

                    <button
                        type="button"
                        class="admin-delete-match"
                        data-index="${index}">

                        حذف

                    </button>

                </div>
            `;


            list.appendChild(card);
        }
    );


    list
        .querySelectorAll(
            ".admin-edit-match"
        )
        .forEach(
            function (button) {

                button.addEventListener(
                    "click",
                    function () {

                        const index =
                            Number(
                                button.dataset.index
                            );

                        showMatchForm(index);

                    }
                );

            }
        );


    list
        .querySelectorAll(
            ".admin-delete-match"
        )
        .forEach(
            function (button) {

                button.addEventListener(
                    "click",
                    async function () {

                        const index =
                            Number(
                                button.dataset.index
                            );

                        await deleteMatch(index);

                    }
                );

            }
        );
}


/* =========================
   نموذج المباراة
   ========================= */

function showMatchForm(index = null) {

    const container =
        document.getElementById(
            "matchFormContainer"
        );

    if (!container) return;


    const isEditing =
        index !== null;


    const match =
        isEditing
            ? leagueData.matches[index]
            : {
                id: getNextMatchId(),
                date: "",
                time: "",
                stage: "الجولة 1",
                team1: "",
                team2: "",
                score1: 0,
                score2: 0,
                status: "upcoming",
                scorers: [],
                cards: [],
                polls: {
                    t1: 0,
                    t2: 0
                }
            };


    const teams =
        leagueData.teams || [];


    const teamOptions =
        teams.map(
            function (team) {

                const selected1 =
                    team.name === match.team1
                        ? "selected"
                        : "";

                const selected2 =
                    team.name === match.team2
                        ? "selected"
                        : "";


                return `
                    <option
                        value="${escapeHtml(team.name)}"
                        data-team1="${selected1}"
                        data-team2="${selected2}">
                        ${escapeHtml(team.name)}
                    </option>
                `;
            }
        )
        .join("");


    container.innerHTML = `

        <div class="match-form-card">

            <div class="match-form-header">

                <div>

                    <span>
                        ${isEditing
                            ? "EDIT MATCH"
                            : "NEW MATCH"}
                    </span>

                    <h3>
                        ${isEditing
                            ? "تعديل المباراة"
                            : "إضافة مباراة"}
                    </h3>

                </div>

                <button
                    type="button"
                    id="cancelMatchForm"
                    class="admin-secondary-button">

                    إلغاء

                </button>

            </div>


            <form id="matchAdminForm">


                <div class="admin-form-grid">


                    <!-- الفريق الأول -->

                    <div class="admin-form-field">

                        <label>
                            الفريق الأول
                        </label>

                        <select
                            id="matchTeam1"
                            required>

                            <option value="">
                                اختر الفريق
                            </option>

                            ${teamOptions}

                        </select>

                    </div>


                    <!-- الفريق الثاني -->

                    <div class="admin-form-field">

                        <label>
                            الفريق الثاني
                        </label>

                        <select
                            id="matchTeam2"
                            required>

                            <option value="">
                                اختر الفريق
                            </option>

                            ${teamOptions}

                        </select>

                    </div>


                    <!-- التاريخ -->

                    <div class="admin-form-field">

                        <label>
                            التاريخ
                        </label>

                        <input
                            type="text"
                            id="matchDate"
                            value="${escapeHtml(
                                match.date || ""
                            )}"
                            placeholder="مثال: 10 سبتمبر 2026"
                            required>

                    </div>


                    <!-- الوقت -->

                    <div class="admin-form-field">

                        <label>
                            الوقت
                        </label>

                        <input
                            type="text"
                            id="matchTime"
                            value="${escapeHtml(
                                match.time || ""
                            )}"
                            placeholder="مثال: 04:30 مساءً"
                            required>

                    </div>


                    <!-- الجولة -->

                    <div class="admin-form-field">

                        <label>
                            الجولة
                        </label>

                        <input
                            type="text"
                            id="matchStage"
                            value="${escapeHtml(
                                match.stage || ""
                            )}"
                            placeholder="مثال: الجولة 3"
                            required>

                    </div>


                    <!-- الحالة -->

                    <div class="admin-form-field">

                        <label>
                            حالة المباراة
                        </label>

                        <select
                            id="matchStatus">

                            <option
                                value="upcoming"
                                ${match.status === "upcoming"
                                    ? "selected"
                                    : ""}>

                                قادمة

                            </option>

                            <option
                                value="live"
                                ${match.status === "live"
                                    ? "selected"
                                    : ""}>

                                مباشر

                            </option>

                            <option
                                value="finished"
                                ${match.status === "finished"
                                    ? "selected"
                                    : ""}>

